# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: User whitelist (comma-separated Telegram user IDs)
# If not set, all users are allowed
ALLOWED_USERS=

# ============================================
# Application Settings
# ============================================
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# File Handling
# ============================================
MAX_FILE_SIZE_MB=50
TEMP_STORAGE_PATH=data/storage/temp
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_SECONDS=300

# ============================================
# yt-dlp Configuration
# ============================================
YTDLP_FORMAT=bestaudio/best
# Optional: Path to cookies.txt for authenticated requests
# YTDLP_COOKIES_PATH=/path/to/cookies.txt
# Optional: Proxy URL (e.g., socks5://127.0.0.1:1080)
# YTDLP_PROXY=

# ============================================
# Worker Pool
# ============================================
WORKER_POOL_SIZE=5
JOB_QUEUE_MAX_SIZE=100

# ============================================
# Retry Configuration
# ============================================
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# ============================================
# Observability
# ============================================
# SENTRY_DSN=your_sentry_dsn_here
# ENABLE_SENTRY=false

# ============================================
# Deployment
# ============================================
WORKER_CONCURRENCY=1
